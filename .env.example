# Docker / HTTP
HOST_PORT=7860
PORT=7860
NODE_ENV=production
ENABLE_STARTUP_WARMUP=false

# HTTPS / TLS
# Leave empty to serve HTTP. To enable HTTPS, place certificates outside git,
# for example in backend/certs/, and configure both paths.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Frontend build
# Use /api when the backend serves the compiled frontend from the same container.
VITE_API_BASE_URL=/api

# CORS
# Empty in production allows same-origin requests. Use comma-separated origins only when needed.
CORS_ORIGIN=

# External format links
FORMATOS_BASE_URL=

# Authentication
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=8h
AUTH_REMEMBER_TOKEN_TTL=7d
AUTH_TOKEN_ISSUER=aurora
AUTH_TOKEN_AUDIENCE=aurora-api

# Local admin login
# Keep disabled in production unless there is a controlled temporary need.
AUTH_LOCAL_ADMIN_ENABLED=false
AUTH_LOCAL_ADMIN_USERNAME=
AUTH_LOCAL_ADMIN_PASSWORD=

# Azure AD SSO / Microsoft identity platform
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_ALLOWED_EMAIL_DOMAINS=
# Recommended Entra ID / Azure AD app roles for AURORA: admin,user.
# Use AZURE_AD_REQUIRED_APP_ROLES=admin,user when the entity wants to require
# that every authenticated account has one of the AURORA app roles assigned.
AZURE_AD_REQUIRED_GROUP_IDS=
AZURE_AD_REQUIRED_APP_ROLES=
# Optional Entra ID group Object IDs that receive Aurora internal admin role.
AZURE_AD_ADMIN_GROUP_IDS=

# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_SCHEMA=
ORACLE_GESTION_ID_SEQUENCE=

# Oracle pool
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60

# Monthly database loads
AURORA_CARGAS_DIR=
# Roles allowed to operate the monthly load module. Must match the role values
# received from Azure AD app roles or the temporary local admin role.
CARGUEBD_ADMIN_ROLES=admin,carguebd,cargas_bd
# Python executable used to run scripts/cargas_bd/loader_service.py.
CARGUEBD_PYTHON=python3
CARGUEBD_AURORA10_ENABLED=true
CARGUEBD_SISIPEC_PROCEDURE=
CARGUEBD_SKIP_ETL=false
CARGUEBD_MAX_FILE_MB=120
