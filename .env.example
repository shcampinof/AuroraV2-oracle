# =========================================================
# AURORA - PLANTILLA DE PRODUCCION / DESPLIEGUE
# Copiar como .env y completar con valores reales.
# No subir .env reales al repositorio.
# =========================================================

# Docker / HTTP(S)
# HOST_PORT es el puerto externo publicado por Docker.
# PORT es el puerto interno donde escucha Node dentro del contenedor/proceso.
# Recomendado: publicar 443 -> 7860 con Docker, Nginx, Apache o balanceador.
HOST_PORT=443
PORT=7860
NODE_ENV=production
ENABLE_STARTUP_WARMUP=false

# HTTPS / TLS
# Si Aurora termina TLS directamente, configure ambos paths.
# Si TLS termina en Nginx/Apache/balanceador, dejar vacio y hacer proxy HTTP interno.
# En despliegue directo actual con certificados en backend/certs:
# HTTPS_KEY_PATH=certs/aurora.key
# HTTPS_CERT_PATH=certs/aurora.crt
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Frontend build
# Use /api when the backend serves the compiled frontend from the same container.
VITE_API_BASE_URL=/api

# CORS
# Empty in production allows same-origin requests. Use comma-separated origins only when needed.
CORS_ORIGIN=

# External format links
FORMATOS_BASE_URL=

# Authentication / sesiones Aurora
# AUTH_JWT_SECRET debe ser largo, aleatorio y unico por ambiente.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=8h
AUTH_REMEMBER_TOKEN_TTL=7d
AUTH_TOKEN_ISSUER=aurora
AUTH_TOKEN_AUDIENCE=aurora-api

# Local admin login
# Keep disabled in production unless there is a controlled temporary need.
AUTH_LOCAL_ADMIN_ENABLED=false
AUTH_LOCAL_ADMIN_USERNAME=
AUTH_LOCAL_ADMIN_PASSWORD=

# Internal user access control
# open: users accepted by Azure/domain rules can enter and are synced locally.
# managed: only enabled users listed in Aurora can enter.
# Produccion recomendada: managed, con al menos un correo bootstrap admin.
AUTH_USER_ACCESS_MODE=open
AUTH_BOOTSTRAP_ADMIN_EMAILS=
# En Docker Compose se recomienda /app/backend/storage/auth/auth-users.json
# con volumen persistente. En Node/PM2 directo puede dejarse vacio para usar
# backend/storage/auth-users.json.
AUTH_USER_STORE_PATH=

# LDAP / Active Directory direct bind
# Opcion alternativa a Azure: el usuario escribe usuario/contrasena y Aurora
# valida contra AD/LDAP. No es SSO transparente.
LDAP_ENABLED=false
LDAP_URL=
LDAP_DOMAIN=defensoria.gov.co
LDAP_ALLOWED_EMAIL_DOMAINS=defensoria.gov.co
LDAP_TIMEOUT_MS=8000

# Azure AD SSO / Microsoft identity platform
# Requiere que la App Registration tenga Redirect URI SPA exacta:
# https://aurora.defensoria.gov.co
# https://auroratest.defensoria.gov.co:7860 (si se usa pruebas por puerto)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_ALLOWED_EMAIL_DOMAINS=
# Recommended Entra ID / Azure AD app roles for AURORA: admin,user.
# Use AZURE_AD_REQUIRED_APP_ROLES=admin,user when the entity wants to require
# that every authenticated account has one of the AURORA app roles assigned.
AZURE_AD_REQUIRED_GROUP_IDS=
AZURE_AD_REQUIRED_APP_ROLES=
# Optional Entra ID group Object IDs that receive Aurora internal admin role.
AZURE_AD_ADMIN_GROUP_IDS=

# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_SCHEMA=
# Secuencia opcional para ID_GESTION si la tabla GESTION no autogenera ID.
ORACLE_GESTION_ID_SEQUENCE=

# Oracle pool
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60

# Monthly database loads
AURORA_CARGAS_DIR=
# Roles allowed to operate the monthly load module. Must match the role values
# received from Azure AD app roles or the temporary local admin role.
CARGUEBD_ADMIN_ROLES=admin,carguebd,cargas_bd
# Python executable used to run scripts/cargas_bd/loader_service.py.
CARGUEBD_PYTHON=python3
CARGUEBD_AURORA10_ENABLED=true
CARGUEBD_SISIPEC_PROCEDURE=
CARGUEBD_SKIP_ETL=false
CARGUEBD_MAX_FILE_MB=120
# Defensor exacto cuyas actuaciones ficticias pueden depurarse desde el panel.
CARGUEBD_ACTUACIONES_CLEANUP_DEFENSOR=PRUEBA PILOTO
