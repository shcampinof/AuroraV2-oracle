# Backend / HTTP
PORT=7860
NODE_ENV=production
ENABLE_STARTUP_WARMUP=false

# Authentication
# In production, local admin is disabled by default when this variable is omitted.
# Enable it only for controlled break-glass access and never with admin/admin.
AUTH_LOCAL_ADMIN_ENABLED=false
AUTH_LOCAL_ADMIN_USERNAME=
AUTH_LOCAL_ADMIN_PASSWORD=
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=8h
AUTH_REMEMBER_TOKEN_TTL=7d
AUTH_TOKEN_ISSUER=aurora
AUTH_TOKEN_AUDIENCE=aurora-api

# Azure AD SSO / Microsoft identity platform
# Register AURORA as a Single-page application in Azure App registrations.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
# Optional hardening: comma-separated allowed domains, Azure AD group object IDs, or app roles.
AZURE_AD_ALLOWED_EMAIL_DOMAINS=
AZURE_AD_REQUIRED_GROUP_IDS=
AZURE_AD_REQUIRED_APP_ROLES=

# Optional CORS allowlist. Empty allows all origins only in local development.
# In production, empty CORS_ORIGIN allows same-origin requests only.
CORS_ORIGIN=

# Oracle (required)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
# Optional: schema used to qualify Oracle objects. Defaults to ORACLE_USER.
ORACLE_SCHEMA=

# Optional: sequence for ID_GESTION if the table does not autogenerate
ORACLE_GESTION_ID_SEQUENCE=

# Optional: base URL for formato downloads
FORMATOS_BASE_URL=

# Optional pool settings
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
